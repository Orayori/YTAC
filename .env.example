# ================================
# YTAC Configuration
# ================================

# AI backend:
# local  = Ollama + local Whisper (recommended for $0 operation)
# openai = OpenAI API
AI_BACKEND=local

# ================================
# Local AI
# ================================

# Ollama model used for clip selection
OLLAMA_MODEL=qwen2.5:3b

# Maximum number of candidate windows
MAX_CANDIDATES=80

# Minimum overlap ratio before two clips are considered duplicates
MIN_OVERLAP=0.35

# ================================
# Video Rendering
# ================================

# FFmpeg encoding preset
FFMPEG_PRESET=veryfast

# FFmpeg quality
# Lower number = higher quality / larger file
FFMPEG_CRF=20

# Output directory
OUTPUT_DIR=output

# ================================
# Optional OpenAI
# ================================

# Only required when:
# AI_BACKEND=openai

OPENAI_API_KEY=replace-me
